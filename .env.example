# Port the Node server (HTTP + Socket.IO) listens on.
PORT=3001

# Comma-separated list of origins allowed to open Socket.IO connections.
# Needed when the frontend is hosted elsewhere (e.g. Vercel). `*` matches part
# of a subdomain, which covers Vercel preview deployments.
# CORS_ORIGIN=https://typeracer.vercel.app,https://typeracer-*.vercel.app

# Frontend only (read at build time by Vite; set it in Vercel's project settings):
# URL of the realtime server. Leave unset when this Node server also serves the frontend.
# VITE_SERVER_URL=https://typeracer-realtime.onrender.com

# Gameplay timings (milliseconds). Defaults shown.
# COUNTDOWN_MS=3000
# RECONNECT_GRACE_MS=30000
# HOST_GRACE_MS=5000
# RACE_MAX_DURATION_MS=600000
# PROGRESS_INTERVAL_MS=250
# MAX_ROOMS=1000
