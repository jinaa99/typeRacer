# Port the Node server (HTTP + Socket.IO) listens on.
PORT=3001

# Comma-separated list of origins allowed to open Socket.IO connections.
# Only needed when the frontend is hosted on a different origin than the server.
# CORS_ORIGIN=https://your-frontend.example.com

# Frontend only (read at build time by Vite): URL of the realtime server.
# Leave unset when the frontend is served by this same Node server.
# VITE_SERVER_URL=https://your-realtime-server.example.com

# Gameplay timings (milliseconds). Defaults shown.
# COUNTDOWN_MS=3000
# RECONNECT_GRACE_MS=30000
# HOST_GRACE_MS=5000
# RACE_MAX_DURATION_MS=600000
# PROGRESS_INTERVAL_MS=250
# MAX_ROOMS=1000
